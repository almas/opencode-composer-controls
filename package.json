{
  "name": "opencode-composer-controls",
  "version": "0.1.0",
  "type": "module",
  "description": "チャット入力欄の自由なリサイズと、送信キー設定（既定: Ctrl+Enter で送信 / Enter で改行）を OpenCode Desktop に追加するプラグイン",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/almas/opencode-composer-controls.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "composer",
    "input",
    "keybind"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist"
  ],
  "dependencies": {
    "@opencode/plugin": "2.3.0"
  },
  "devDependencies": {
    "solid-js": "^1.9.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "test": "vitest run"
  }
}
